    <TIER ANNOTATOR="sashamartiusheva" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="@aam2008f" TIER_ID="text@aam2008f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>да Большая Перемена это вообще огромная часть моей жизни</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>которая началась / в шестом классе /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>и продолжалась вот до одиннадцатого /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>тогда / э благодаря моей маме вообще я узнала про этот конкурс</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts49">
                <ANNOTATION_VALUE>и / это был действительно такой переломный момент для меня</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>потому что сейчас / большая часть моего круга общения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>и вообще даже то</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts75">
                <ANNOTATION_VALUE>что я сейчас здесь сижу нахожусь вообще в Москве /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts76" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>это всё / сто процентов связано с этой Большой Переменой /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>э потому что /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>вообще / изначально я там просто решала задания проходила какую-то игру</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>и мне казалось это всё каким-то детским и глупым /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
